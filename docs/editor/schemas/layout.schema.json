{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "layout.schema.json",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "schemaVersion": {
      "const": 1
    },
    "id": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9_]*$"
    },
    "name": {
      "type": "string"
    },
    "notes": {
      "type": "string"
    },
    "aliases": {
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^[a-z][a-z0-9_-]*$"
      },
      "minItems": 0
    },
    "draft": {
      "type": "boolean"
    },
    "width": {
      "type": "integer",
      "minimum": 1,
      "maximum": 256
    },
    "height": {
      "type": "integer",
      "minimum": 1,
      "maximum": 256
    },
    "movementTicksPerTile": {
      "type": "integer",
      "minimum": 1,
      "maximum": 2147483647
    },
    "tiles": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "x": {
            "type": "integer",
            "minimum": -2147483648,
            "maximum": 2147483647
          },
          "y": {
            "type": "integer",
            "minimum": -2147483648,
            "maximum": 2147483647
          },
          "kind": {
            "enum": [
              "blocked",
              "water"
            ]
          }
        },
        "required": [
          "x",
          "y",
          "kind"
        ]
      },
      "minItems": 0,
      "maxItems": 65536
    },
    "buildings": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "instanceId": {
            "type": "string",
            "minLength": 1
          },
          "buildingId": {
            "type": "string",
            "minLength": 1
          },
          "x": {
            "type": "integer",
            "minimum": -2147483648,
            "maximum": 2147483647
          },
          "y": {
            "type": "integer",
            "minimum": -2147483648,
            "maximum": 2147483647
          },
          "rotation": {
            "enum": [
              0,
              90,
              180,
              270
            ]
          },
          "ownership": {
            "enum": [
              "public",
              "private"
            ]
          }
        },
        "required": [
          "instanceId",
          "buildingId",
          "x",
          "y",
          "rotation",
          "ownership"
        ]
      },
      "minItems": 0
    },
    "spawns": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "x": {
            "type": "integer",
            "minimum": -2147483648,
            "maximum": 2147483647
          },
          "y": {
            "type": "integer",
            "minimum": -2147483648,
            "maximum": 2147483647
          },
          "role": {
            "type": "string",
            "minLength": 1
          }
        },
        "required": [
          "id",
          "x",
          "y",
          "role"
        ]
      },
      "minItems": 0
    },
    "zones": {
      "type": "array",
      "maxItems": 0
    }
  },
  "required": [
    "schemaVersion",
    "id",
    "name",
    "width",
    "height",
    "movementTicksPerTile",
    "tiles",
    "buildings",
    "spawns",
    "zones",
    "draft"
  ]
}
