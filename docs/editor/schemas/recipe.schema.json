{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "recipe.schema.json",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "schemaVersion": {
      "const": 1
    },
    "id": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9_]*$"
    },
    "name": {
      "type": "string"
    },
    "notes": {
      "type": "string"
    },
    "aliases": {
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^[a-z][a-z0-9_-]*$"
      },
      "minItems": 0
    },
    "draft": {
      "type": "boolean"
    },
    "inputs": {
      "type": "array",
      "items": {
        "$ref": "base-common.schema.json#/$defs/amount"
      },
      "minItems": 0
    },
    "outputs": {
      "type": "array",
      "items": {
        "$ref": "base-common.schema.json#/$defs/amount"
      },
      "minItems": 1
    },
    "workTicks": {
      "type": "integer",
      "minimum": 1,
      "maximum": 2147483647
    },
    "workerTags": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "minItems": 0
    }
  },
  "required": [
    "schemaVersion",
    "id",
    "name",
    "inputs",
    "outputs",
    "workTicks",
    "workerTags",
    "draft"
  ]
}
