{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/t626644510/mygame/blob/main/docs/editor/schemas/request.schema.json",
  "title": "Editor request (P0)",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "id", "kind", "owner", "target", "title", "status", "createdAt"],
  "properties": {
    "schemaVersion": { "const": 1 },
    "id": { "type": "string", "pattern": "^REQ-[0-9]{4}$" },
    "kind": { "type": "string", "enum": ["note", "new_effect", "new_condition", "new_selector", "new_status", "new_building_function", "new_item_property", "balance", "bug"] },
    "owner": { "type": "string", "enum": ["combat", "base", "engineering", "art", "world", "planning"] },
    "target": { "type": "string", "pattern": "^(global|(item|skill|character|encounter|trial|rule|building|recipe|layout|scenario):[a-z][a-z0-9_-]*)$" },
    "title": { "type": "string", "minLength": 1, "pattern": "\\S" },
    "status": { "type": "string", "enum": ["open", "triaged", "in_progress", "done", "rejected"] },
    "createdAt": { "type": "string", "description": "Explicit metadata only; empty means unknown. Nonempty values are valid ISO calendar dates.", "anyOf": [{ "const": "" }, { "format": "date", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$" }] },
    "field": { "type": "string" },
    "body": { "type": "string" },
    "expected": { "type": "string" },
    "resolvedBy": { "type": "string" }
  }
}
