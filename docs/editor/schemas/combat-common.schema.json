        "row",
        "column"
      ],
      "properties": {
        "unitId": {
          "type": "string"
        },
        "characterId": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9_]*$"
        },
        "name": {
          "type": [
            "string",
            "null"
          ]
        },
        "team": {
          "type": [
            "string",
            "null"
          ]
        },
        "row": {
          "type": "integer",
          "minimum": 0,
          "maximum": 2
        },
        "column": {
          "type": "integer",
          "minimum": 0,
          "maximum": 2
        },
        "hp": {
          "type": "integer",
          "minimum": -1,
          "maximum": 2147483647
        },
        "mp": {
          "type": "integer",
          "minimum": -1,
          "maximum": 2147483647
        },
        "initialReadyTime": {
          "type": "number",
          "minimum": 0
        },
        "vulnerable": {
          "type": "boolean"
        },
        "statuses": {
          "type": [
            "array",
            "null"
          ],
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
