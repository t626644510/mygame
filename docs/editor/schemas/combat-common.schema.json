          "type": [
            "string",
            "null"
          ]
        },
        "effectKind": {
          "type": "string"
        },
        "magnitude": {
          "type": "integer",
          "minimum": 0,
          "maximum": 2147483647
        },
        "mpCost": {
          "type": "integer",
          "minimum": 0,
          "maximum": 2147483647
        },
        "baseWait": {
