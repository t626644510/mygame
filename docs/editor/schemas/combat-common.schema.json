          }
        },
        "operators": {
          "type": "array",
          "items": {
            "enum": [
              "and",
              "or"
            ]
          }
        },
        "grouping": {
          "enum": [
            "left",
            "right",
            "",
            null
          ]
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "operation": {
                "const": "mixed"
              }
            },
            "required": [
              "operation"
            ]
          },
          "then": {
            "required": [
              "operators",
              "grouping"
            ],
            "properties": {
              "terms": {
                "minItems": 3,
                "maxItems": 3
              },
              "operators": {
                "minItems": 2,
                "maxItems": 2
              },
              "grouping": {
                "enum": [
                  "left",
                  "right"
                ]
              }
            }
          }
        }
      ]
