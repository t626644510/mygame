    "instruction": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "condition",
        "scope",
        "selector",
        "actionId"
      ],
      "properties": {
        "id": {
          "type": "string"
        },
        "label": {
          "type": [
            "string",
            "null"
          ]
        },
        "condition": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "operation",
            "terms"
          ],
          "properties": {
            "operation": {
              "enum": [
                "all",
                "any",
                "mixed"
              ]
            },
            "terms": {
              "type": "array",
              "minItems": 1,
              "maxItems": 3,
              "items": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "kind"
                ],
                "properties": {
                  "kind": {
                    "type": "string"
                  },
                  "threshold": {
                    "type": "number",
                    "minimum": 0
                  },
                  "subject": {
                    "type": [
                      "string",
                      "null"
                    ]
                  },
                  "value": {
                    "type": [
                      "string",
                      "null"
                    ]
                  }
                }
              }
            },
            "operators": {
              "type": "array",
              "items": {
                "enum": [
                  "and",
                  "or"
                ]
              }
            },
            "grouping": {
              "enum": [
                "left",
                "right",
                "",
                null
              ]
            }
          },
          "allOf": [
            {
              "if": {
                "properties": {
                  "operation": {
                    "const": "mixed"
                  }
                },
                "required": [
                  "operation"
                ]
              },
              "then": {
                "required": [
                  "operators",
                  "grouping"
                ],
                "properties": {
                  "terms": {
                    "minItems": 3,
                    "maxItems": 3
                  },
                  "operators": {
                    "minItems": 2,
                    "maxItems": 2
                  },
                  "grouping": {
                    "enum": [
                      "left",
                      "right"
                    ]
                  }
                }
              }
            }
          ]
        },
        "scope": {
          "type": "string"
        },
        "selector": {
          "type": "string"
        },
        "actionId": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9_]*$"
        }
      }
    },
    "condition": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "operation",
        "terms"
      ],
      "properties": {
        "operation": {
          "enum": [
            "all",
            "any",
