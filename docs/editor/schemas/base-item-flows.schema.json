{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "base-item-flows.schema.json",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "schemaVersion": {
      "const": 1
    },
    "id": {
      "const": "rules_base_item_flows"
    },
    "sources": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "itemId": {
            "type": "string",
            "minLength": 1
          },
          "kind": {
            "enum": [
              "starting",
              "resident_sale",
              "external_market",
              "gathering"
            ]
          },
          "note": {
            "type": "string"
          }
        },
        "required": [
          "itemId",
          "kind"
        ]
      },
      "minItems": 0
    },
    "sinks": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "itemId": {
            "type": "string",
            "minLength": 1
          },
          "kind": {
            "enum": [
              "resident_need",
              "external_sale"
            ]
          },
          "note": {
            "type": "string"
          }
        },
        "required": [
          "itemId",
          "kind"
        ]
      },
      "minItems": 0
    },
    "notes": {
      "type": "string"
    }
  },
  "required": [
    "schemaVersion",
    "id",
    "sources",
    "sinks"
  ]
}
